{
  "name": "GRGC Phone Tracker",
  "short_name": "Tracker",
  "description": "Track and protect your phone. Locate, ring, lock and message it from anywhere.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
